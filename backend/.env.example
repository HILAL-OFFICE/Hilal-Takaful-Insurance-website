# Server Port
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated without trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500,http://127.0.0.1:5500,https://hilaltakaful.com.ng,https://admin.hilaltakaful.com.ng

# Supabase Credentials
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

